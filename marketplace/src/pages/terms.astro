---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service - Claude Code Plugins"
  description="Terms of Service for Claude Code Plugins marketplace"
>
  <section class="legal-page">
    <div class="container">
      <h1>Terms of Service</h1>

      <!-- GetTerms.io Embed - Terms of Service -->
      <div class="getterms-document-embed" data-getterms="wH2cn" data-getterms-document="terms-of-service" data-getterms-lang="en-us" data-getterms-mode="direct" data-getterms-env="https://gettermscdn.com"></div>
      <script is:inline id="getterms-embed-js" src="https://gettermscdn.com/dist/js/embed.js" async></script>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding: 4rem 0;
    min-height: 70vh;
  }

  .legal-page h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--slate-100);
  }

  .getterms-document-embed {
    color: var(--slate-300);
    line-height: 1.8;
  }

  .getterms-document-embed :global(h2) {
    color: var(--green-400);
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .getterms-document-embed :global(h3) {
    color: var(--slate-200);
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .getterms-document-embed :global(p) {
    margin-bottom: 1rem;
  }

  .getterms-document-embed :global(ul),
  .getterms-document-embed :global(ol) {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  .getterms-document-embed :global(li) {
    margin-bottom: 0.5rem;
  }

  .getterms-document-embed :global(a) {
    color: var(--green-400);
    text-decoration: underline;
  }

  .getterms-document-embed :global(a:hover) {
    color: var(--green-300);
  }
</style>
