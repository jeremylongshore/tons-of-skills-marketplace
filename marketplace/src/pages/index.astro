---
// Homepage — one job: run the install command.
//
// This page was 1,742 lines and 10 sections. It is now ~9 elements. Everything
// removed kept its route and is reachable from the nav; nothing was deleted.
// Killer Skill of the Week, Jeremy's Stash and the Stack Builder moved to
// /collections; the partner row moved to /community. See marketplace/DESIGN.md
// changelog 2026-08-02 for the full accounting.
//
// The single hard-shadowed element on this page is the install block. That is
// the whole design: one action, one shadow, everything else flat.
import { readFileSync } from 'node:fs';
import { dirname, join, parse } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import CountProvenance from '../components/CountProvenance.astro';
import searchIndex from '../data/unified-search-index.json';

// Build-time counts. Every number on this page is real and regenerated by the
// build pipeline — none of them are typed in by hand, so none of them can rot.
const totalSkills = searchIndex.stats.totalSkills;
const totalPlugins = searchIndex.stats.totalPlugins;
const totalAgents = searchIndex.stats.totalAgents || 0;

// Install count (skills.sh, cumulative) and star count (GitHub). Both are
// refreshed daily by .github/workflows/update-npm-stats.yml and both fail soft:
// if the data file has never been written the line simply does not render.
//
// E1.10 freshness bound: each artifact declares max_age_hours alongside
// generatedAt, and an out-of-bound artifact renders exactly like a missing one
// — the page must never present a stale external number as current. The bound
// is checked at build time (this is a static build), which is also when the
// number would otherwise be baked into the page.
type StatsEnvelope = { generatedAt?: string; max_age_hours?: number };
function isFresh(stats: StatsEnvelope): boolean {
  if (typeof stats.generatedAt !== 'string' || typeof stats.max_age_hours !== 'number')
    return false;
  const ageMs = Date.now() - Date.parse(stats.generatedAt);
  return Number.isFinite(ageMs) && ageMs <= stats.max_age_hours * 3_600_000;
}
let skillsStats: StatsEnvelope & { installs?: number; installsDisplay?: string } = {};
try {
  skillsStats = (await import('../data/skills-stats.json')).default as typeof skillsStats;
} catch {
  skillsStats = {};
}
let githubStats: StatsEnvelope & { stars?: number; starsDisplay?: string } = {};
try {
  githubStats = (await import('../data/github-stats.json')).default as typeof githubStats;
} catch {
  githubStats = {};
}
const installsDisplay = isFresh(skillsStats) ? (skillsStats.installsDisplay ?? '') : '';
const starsDisplay = isFresh(githubStats) ? (githubStats.starsDisplay ?? '') : '';

// Marketplace version, read from the REPO ROOT package.json at build time so
// the printed version can never drift from the released one.
//
// SEARCH UPWARD BY NAME — do not count directory levels. The first cut of this
// resolved a fixed `../../../../package.json` against `import.meta.url`, which
// worked on a dev box and BROKE THE VPS DEPLOY (run 30776649017): during an
// Astro build `import.meta.url` is a bundler-transformed module path, not the
// source file's path, so its depth differs per environment. Four levels landed
// on the repo root at `/home/jeremy/000-projects/claude-code-plugins` and on
// nothing at `/srv/tonsofskills/build`, where readFileSync threw and took the
// whole build down.
//
// Walking up until the manifest identifies ITSELF as the monorepo root is
// depth-independent, so it cannot break again when a checkout path changes.
// `marketplace/package.json` is correctly skipped: it carries its own
// independent version (4.19.x) and a different name.
const ROOT_PKG_NAME = 'claude-code-plugins-monorepo';

function findRepoVersion(): string | null {
  // process.cwd() is the Astro project dir during a build; the loop climbs out
  // of it. Starting from cwd rather than import.meta.url is deliberate — cwd is
  // a real filesystem location, not a bundler artefact.
  let dir = process.cwd();
  const { root } = parse(dir);
  for (let i = 0; i < 12; i++) {
    try {
      const pkg = JSON.parse(readFileSync(join(dir, 'package.json'), 'utf8'));
      if (pkg?.name === ROOT_PKG_NAME && typeof pkg.version === 'string') return pkg.version;
    } catch {
      /* no manifest here, or unreadable — keep climbing */
    }
    if (dir === root) break;
    dir = dirname(dir);
  }
  return null;
}

// Fail soft, like every other data read on this page. A version line is nice to
// have; it is NOT worth failing a production deploy over, which is exactly the
// mistake this replaces. Null simply omits the line.
let siteVersion: string | null = null;
try {
  siteVersion = findRepoVersion();
} catch {
  siteVersion = null;
}

// The Claude-Code-native slash command, and the reason this block leads with it
// rather than a shell command: `/plugin marketplace add …` runs INSIDE Claude
// Code. There is nothing to install first. That is the actual differentiator, so
// it gets styled as the Claude Code prompt rather than a `$` terminal.
//
// The `claude-code-plugins` slug is the legacy public one and is deliberately
// NOT "corrected" to the canonical repo name — per CLAUDE.md it is hardcoded in
// the CLI and hundreds of READMEs, GitHub 301s it, and renaming it is a breaking
// API change.
const INSTALL_CMD = '/plugin marketplace add jeremylongshore/claude-code-plugins';

const fmt = (n: number) => n.toLocaleString('en-US');
const pageDescription = `${fmt(totalSkills)} marketplace-visible agent skills across ${fmt(totalPlugins)} catalog plugins for AI coding agents. Free and open source.`;
---

<BaseLayout
    title="Tons of Skills | Skills and extensions for AI coding agents"
    description={pageDescription}
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Tons of Skills",
        "url": "https://tonsofskills.com",
        "description": "An open-source marketplace for portable agent skills and native AI-coding-agent extensions",
        "sameAs": ["https://github.com/jeremylongshore/tons-of-skills-marketplace"]
    })} />

    <main class="home">
        <!-- Meta line: version left, social proof right. Both real, both
             build-time. Neither is a heading; they frame the headline. -->
        <div class="home-meta">
            <span class="home-meta-left">
                {siteVersion && (
                    <>
                        <span class="home-version" title="Marketplace display version; npm packages retain independent package versions">marketplace v{siteVersion}</span>
                        <span class="home-meta-sep">·</span>
                    </>
                )}
                <a href="/changelog">what&rsquo;s new &rarr;</a>
            </span>
            {starsDisplay && (
                <a
                    class="home-meta-right"
                    href="https://github.com/jeremylongshore/tons-of-skills-marketplace"
                    target="_blank"
                    rel="noopener noreferrer"
                >{starsDisplay} stars on GitHub</a>
            )}
        </div>

        <h1 class="home-headline">
            {fmt(totalSkills)} marketplace-visible skills for<br />AI coding agents.
        </h1>

        <p class="home-subhead">
            Plugins, agents and skills for AI coding agents.<br />
            Free and open source.
        </p>

        <p class="home-support-note">
            Portable skills are model-neutral by design. Claude Code is currently verified-native;
            other harnesses are shown only after their integration evidence exists.
        </p>

        <p class="home-support-note">
            Built by Intent Solutions, an applied AI engineering company. These inspectable
            components connect deployment work to tools teams can understand and adapt.
            <a href="https://startaitools.com/deployment-thesis/" style="color: inherit; text-decoration: underline; text-underline-offset: 3px;">How the work connects</a>.
        </p>

        <CountProvenance cohort="marketplace-visible" />

        <!-- THE signature element. One hard offset shadow on an otherwise flat
             canvas; see DESIGN.md § 6 for why it is rationed to one per page. -->
        <div class="install">
            <div class="install-head">
                <span class="install-label">Claude Code</span>
                <button
                    type="button"
                    class="install-copy"
                    data-copy={INSTALL_CMD}
                    aria-label="Copy the install command to your clipboard"
                >Copy</button>
            </div>
            <div class="install-body">
                <span class="install-prompt" aria-hidden="true">&gt;</span><code class="install-cmd">{INSTALL_CMD}</code>
            </div>
        </div>

        <p class="home-installs">
            Installs {fmt(totalPlugins)} plugins
            <span class="home-meta-sep">·</span> {fmt(totalAgents)} agents
            {installsDisplay && (<><span class="home-meta-sep">·</span> {installsDisplay} installs</>)}
        </p>

        <!-- Browse is FIRST and is the only on-site action in this row.
             Before 2026-08-03 both buttons here pointed off-site (GitHub,
             Sponsor), so a visitor who did not copy the install command had no
             route deeper into the site except the nav. Umami for the week to
             2026-08-03: `/` took 324 entries and 225 exits — a 69% exit rate —
             and `/explore/` recorded MORE exits (224) than entries (191),
             meaning it is where sessions end rather than a waypoint. Giving the
             homepage an explicit in-body handoff is the cheapest repair.
             The install block remains the single hard-shadowed CTA; this is a
             secondary action and is styled as one. -->
        <div class="home-actions">
            <a class="btn btn-browse" href="/explore/">
                Browse {fmt(totalSkills)} marketplace-visible skills &rarr;
            </a>
            <a
                class="btn"
                href="https://github.com/jeremylongshore/tons-of-skills-marketplace"
                target="_blank"
                rel="noopener noreferrer"
            >View on GitHub</a>
            <a
                class="btn"
                href="https://github.com/sponsors/jeremylongshore"
                target="_blank"
                rel="noopener noreferrer"
            >Sponsor</a>
        </div>

        <!-- The partner badge + byline used to live HERE, as a block above the
             site footer — which rendered as two footers stacked. They now sit
             inside the real footer in BaseLayout (`.footer-badge-row`), so the
             page ends once. Self-hosted from public/ rather than embedded via
             Credly's script — no third-party request, no tracking vector, no
             rounded-corner widget fighting the design, and it survives any
             change to their embed.

             That badge remains the ONLY partner reference on the site: no
             partner wording in the headline, subhead, meta description or og:
             tags, and it does not propagate to the README or the catalog. -->
    </main>

    <style>
        /* One column, generous vertical rhythm, nothing centered but the page
           itself. Left-aligned throughout — DESIGN.md § 8 rejects center-aligned
           body copy, and a single-action page has no reason to fight that. */
        .home {
            max-width: 60rem;
            margin: 0 auto;
            padding: 8rem var(--space-5) var(--space-12);
        }

        /* ── Meta line ── */
        /* --ink-2, not --ink-3. Measured on this build: --ink-2 on --bg is
           7.72:1 (AAA), --ink-3 is 4.09:1 — which fails WCAG AA's 4.5:1 floor
           for normal-size text. --ink-3 survives below only on the "·"
           separators, which carry no information. */
        .home-meta {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: var(--space-3);
            font-size: var(--text-sm);
            color: var(--ink-2);
            margin-bottom: var(--space-8);
        }

        .home-version {
            color: var(--signal);
            font-weight: 700;
        }

        .home-meta-sep {
            color: var(--ink-3);
            padding: 0 0.35em;
        }

        .home-meta a {
            color: var(--ink-2);
            text-decoration: none;
            border-bottom: 1px solid var(--rule);
        }

        .home-meta a:hover {
            color: var(--ink);
            border-bottom-color: var(--signal);
        }

        /* ── Headline ── */
        .home-headline {
            font-family: var(--font-display);
            font-size: var(--text-3xl);
            font-weight: 800;
            line-height: 1.05;
            /* Mono is wide by construction; tightening here is corrective, not
               a stylistic flourish. */
            letter-spacing: -0.04em;
            text-transform: uppercase;
            color: var(--ink);
            margin: 0 0 var(--space-5);
        }

        .home-subhead {
            font-size: var(--text-lg);
            line-height: 1.5;
            color: var(--ink-2);
            margin: 0 0 var(--space-8);
            max-width: 46ch;
        }

        .home-support-note {
            font-size: var(--text-sm);
            line-height: 1.5;
            color: var(--ink-2);
            margin: calc(var(--space-6) * -1) 0 var(--space-8);
            max-width: 58ch;
        }

        /* ── Install block: the one shadowed element ── */
        .install {
            background: var(--panel);
            border: 1px solid var(--ink);
            box-shadow: var(--shadow-hard);
            max-width: 44rem;
            margin-bottom: var(--space-5);
        }

        .install-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-4);
            padding: var(--space-2) var(--space-3);
            border-bottom: 1px solid var(--rule);
        }

        .install-label {
            font-size: var(--text-xs);
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--ink-2);
        }

        .install-copy {
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink);
            background: transparent;
            border: 1px solid var(--rule);
            /* 44px min touch target per DESIGN.md § 9; the old .copy-btn was
               explicitly listed there as undersized. */
            min-height: 44px;
            min-width: 5rem;
            padding: 0 var(--space-3);
            cursor: pointer;
            transition: background-color var(--duration-fast) var(--ease-out),
                        border-color var(--duration-fast) var(--ease-out);
        }

        .install-copy:hover {
            background: var(--signal-tint);
            border-color: var(--signal-edge);
        }

        .install-copy[data-copied='true'] {
            background: var(--signal);
            border-color: var(--signal);
            color: var(--bg);
        }

        .install-body {
            display: flex;
            align-items: baseline;
            gap: var(--space-2);
            padding: var(--space-4) var(--space-3);
            overflow-x: auto;
        }

        /* The Claude Code prompt marker, not a shell `$`. The distinction is the
           point of leading with the slash command. */
        .install-prompt {
            color: var(--signal);
            font-weight: 700;
            flex-shrink: 0;
        }

        .install-cmd {
            font-family: var(--font-mono);
            font-size: var(--text-base);
            color: var(--ink);
            white-space: nowrap;
        }

        .home-installs {
            font-size: var(--text-sm);
            color: var(--ink-2);
            margin: 0 0 var(--space-6);
        }

        /* ── Actions ── */
        .home-actions {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
            padding: 0 var(--space-5);
            font-size: var(--text-sm);
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--ink);
            background: transparent;
            border: 1px solid var(--rule);
            transition: border-color var(--duration-fast) var(--ease-out),
                        background-color var(--duration-fast) var(--ease-out);
        }

        .btn:hover {
            border-color: var(--signal);
            background: var(--signal-tint);
        }

        /* The on-site action gets the signal border at rest so it reads as the
           default next step among three otherwise-identical buttons. It stays a
           bordered button, NOT a filled one — DESIGN.md § 4 allows one primary
           CTA per page and the install block is already it. */
        .btn-browse {
            border-color: var(--signal-edge);
        }

        .btn-browse:hover {
            background: var(--signal-tint);
            border-color: var(--signal);
        }

        /* Focus must stay obvious now that nothing is rounded — a square outline
           on a square element is easy to lose, so it is offset and uses the
           signal accent rather than the UA default. */
        .home a:focus-visible,
        .install-copy:focus-visible {
            outline: 2px solid var(--signal);
            outline-offset: 3px;
        }

        @media (max-width: 768px) {
            .home {
                padding: 6rem var(--space-4) var(--space-10);
            }

            .home-headline {
                font-size: var(--text-2xl);
            }

            .install-cmd {
                font-size: var(--text-sm);
            }
        }
    </style>

    <script>
        // Copy the install command. Falls back to a hidden textarea + execCommand
        // because navigator.clipboard is unavailable on non-secure origins, which
        // includes `astro dev` over a LAN address — without the fallback the
        // button silently does nothing during local review.
        document.querySelectorAll<HTMLButtonElement>('.install-copy').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const text = btn.dataset.copy ?? '';
                if (!text) return;
                try {
                    if (navigator.clipboard?.writeText) {
                        await navigator.clipboard.writeText(text);
                    } else {
                        const ta = document.createElement('textarea');
                        ta.value = text;
                        ta.setAttribute('readonly', '');
                        ta.style.position = 'fixed';
                        ta.style.left = '-9999px';
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                    }
                } catch {
                    return; // leave the label alone rather than claim a copy that failed
                }
                const original = btn.textContent;
                btn.dataset.copied = 'true';
                btn.textContent = 'Copied';
                setTimeout(() => {
                    delete btn.dataset.copied;
                    btn.textContent = original;
                }, 1600);
            });
        });
    </script>
</BaseLayout>
