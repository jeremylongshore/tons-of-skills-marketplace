---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoworkGrid from '../components/CoworkGrid.astro';

// The build pipeline must generate this projection before Astro renders.
// Failing here prevents stale or invented totals from reaching the public site.
const manifest = (await import('../data/cowork-manifest.json')).default;
if (
  !manifest ||
  !Array.isArray(manifest.plugins) ||
  !Array.isArray(manifest.bundles) ||
  !manifest.megaZip ||
  typeof manifest.totalPlugins !== 'number' ||
  typeof manifest.totalSkills !== 'number'
) {
  throw new Error('Cowork manifest is missing required generated fields');
}

const megaZip = manifest.megaZip;
const totalPlugins = manifest.totalPlugins;
const totalSkills = manifest.totalSkills;
const heroPluginCount = totalPlugins;
const heroSkillCount = totalSkills;
const megaPluginCount = totalPlugins;
const megaSkillCount = totalSkills;
const categoryPackCount = manifest.bundles.length;
const allPlugins = manifest.plugins;
---

<BaseLayout
  title="Download Plugin Packs for Claude Cowork | No Terminal Needed"
  description="Download plugin and skill packs as zip files for Claude Cowork users. One-click downloads, no CLI required."
>
  <style>
    .cowork-hero {
      background: var(--panel);
      color: white;
      padding: 4rem 2rem 3rem;
      text-align: center;
    }

    .cowork-hero h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      margin: 0 0 1rem;
      font-family: var(--font-body);
      line-height: 1.2;
    }

    .cowork-hero p {
      font-size: 1.15rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .cowork-hero-stats {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .cowork-hero-stat {
      text-align: center;
    }

    .cowork-hero-stat .stat-number {
      font-size: 2rem;
      font-weight: 800;
      display: block;
      font-family: var(--font-body);
    }

    .cowork-hero-stat .stat-label {
      font-size: 0.85rem;
      opacity: 0.8;
    }

    /* Mega download banner */
    .mega-banner {
      background: var(--card);
      border: 3px solid var(--brand-blue, #6a9bcc);
      border-radius: 0;
      padding: 2rem;
      max-width: 800px;
      margin: -2rem auto 0;
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      
    }

    .mega-info h2 {
      font-size: 1.5rem;
      font-weight: 800;
      margin: 0 0 0.5rem;
      font-family: var(--font-body);
    }

    .mega-info p {
      color: var(--brand-mid-gray, #6b7280);
      margin: 0;
      font-size: 0.95rem;
    }

    .mega-stats {
      display: flex;
      gap: 1rem;
      margin-top: 0.75rem;
    }

    .mega-stat {
      border: 1px solid var(--rule, var(--brand-light-gray));
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      font-weight: 500;
      font-family: var(--font-mono);
      color: var(--ink-2, var(--brand-mid-gray));
    }

    .mega-download-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      background: var(--brand-blue, #6a9bcc);
      color: white;
      border: none;
      border-radius: 0;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      font-family: var(--font-body);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .mega-download-btn:hover {
      background: #4a7db0;
      transform: scale(1.03);
    }

    /* Section styles */
    .cowork-section {
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .cowork-section-title {
      font-size: 1.75rem;
      font-weight: 800;
      margin: 0 0 0.5rem;
      font-family: var(--font-body);
    }

    .cowork-section-subtitle {
      color: var(--brand-mid-gray, #6b7280);
      margin: 0 0 2rem;
      font-size: 1rem;
    }

    /* Security section */
    .security-banner {
      background: var(--panel, var(--surface-2));
      border: 1px solid var(--rule, var(--brand-light-gray));
      border-radius: 0;
      padding: 1.5rem 2rem;
      margin: 2rem auto;
      max-width: 1200px;
    }

    .security-banner h3 {
      color: var(--ink, var(--brand-dark));
      font-size: 1.1rem;
      margin: 0 0 0.75rem;
      font-family: var(--font-body);
    }

    .security-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 0.5rem;
    }

    .security-list li {
      color: var(--ink-2, var(--brand-mid-gray));
      font-size: 0.9rem;
    }

    /* Setup guide */
    .setup-guide {
      background: var(--brand-light, #f8f9fa);
      border-radius: 0;
      padding: 2.5rem;
      margin-top: 2rem;
    }

    .setup-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .setup-step {
      text-align: center;
      padding: 1.5rem;
      background: var(--card);
      border-radius: 0;
      border: 1px solid var(--brand-light-gray, #e5e7eb);
    }

    .step-number {
      color: var(--ink-2, var(--brand-mid-gray));
      font-weight: 500;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
      font-family: var(--font-mono);
    }

    .setup-step h4 {
      font-size: 1rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
      font-family: var(--font-body);
    }

    .setup-step p {
      color: var(--brand-mid-gray, #6b7280);
      font-size: 0.85rem;
      margin: 0;
      line-height: 1.5;
    }

    /* Learning path */
    .learning-path {
      background: var(--signal-tint);
      border-radius: 0;
      padding: 2.5rem;
      margin-top: 2rem;
    }

    .learning-path h3 {
      font-size: 1.3rem;
      font-weight: 800;
      margin: 0 0 0.75rem;
      font-family: var(--font-body);
    }

    .learning-path p {
      color: var(--brand-mid-gray, #6b7280);
      margin: 0 0 1.5rem;
    }

    .learning-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .learning-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: var(--card);
      color: #92400e;
      border: 2px solid #f59e0b;
      border-radius: 0;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s;
      font-family: var(--font-body);
    }

    .learning-link:hover {
      background: #f59e0b;
      color: white;
    }

    /* Individual plugin search */
    .plugin-search-container {
      margin-top: 2rem;
    }

    .plugin-search-input {
      width: 100%;
      max-width: 500px;
      padding: 0.75rem 1rem 0.75rem 2.5rem;
      border: 2px solid var(--brand-light-gray, #e5e7eb);
      border-radius: 0;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
      background: var(--card) url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='11' cy='11' r='8'/%3E%3Cpath d='M21 21l-4.35-4.35'/%3E%3C/svg%3E") no-repeat 0.75rem center;
    }

    .plugin-search-input:focus {
      border-color: #3b82f6;
    }

    .plugin-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
      max-height: 600px;
      overflow-y: auto;
    }

    .plugin-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: var(--card);
      border: 1px solid var(--brand-light-gray, #e5e7eb);
      border-radius: 0;
      gap: 0.5rem;
    }

    .plugin-item-name {
      font-weight: 600;
      font-size: 0.85rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
    }

    .plugin-item-meta {
      font-size: 0.75rem;
      color: var(--brand-mid-gray, #6b7280);
      white-space: nowrap;
    }

    .plugin-dl-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.3rem 0.6rem;
      background: var(--brand-blue, #6a9bcc);
      color: white;
      border: none;
      border-radius: 0;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s;
      flex-shrink: 0;
    }

    .plugin-dl-btn:hover {
      background: #4a7db0;
    }

    .plugin-count-label {
      color: var(--brand-mid-gray, #6b7280);
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }

    @media (max-width: 768px) {
      .mega-banner {
        flex-direction: column;
        text-align: center;
        margin: -1.5rem 1rem 0;
      }

      .cowork-hero {
        padding: 3rem 1.5rem 2.5rem;
      }

      .cowork-hero-stats {
        gap: 1rem;
      }

      .plugin-list {
        grid-template-columns: 1fr;
      }

      .plugin-item {
        min-width: 0;
      }

      .plugin-item-name {
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Prereq banner — above the hero, full-bleed, amber */
    .cowork-prereq {
      background: var(--panel, var(--surface-2));
      border-top: 1px solid var(--rule, var(--brand-light-gray));
      border-bottom: 1px solid var(--rule, var(--brand-light-gray));
      padding: 0.9rem 1.5rem;
      color: var(--ink-2, var(--brand-mid-gray));
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .cowork-prereq .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .cowork-prereq strong {
      color: var(--ink, var(--brand-dark));
    }

    .cowork-prereq a {
      color: var(--ink, var(--brand-dark));
      font-weight: 700;
      text-decoration: underline;
      white-space: nowrap;
    }

    .cowork-prereq a:hover {
      color: var(--ink-2, var(--brand-mid-gray));
    }

    /* Official Cowork resources block */
    .official-resources {
      background: var(--surface-2);
      border: 2px solid #cbd5e1;
      border-radius: 0;
      padding: 1.75rem 2rem;
      max-width: 1200px;
      margin: 2rem auto;
    }

    .official-resources h2 {
      font-size: 1.35rem;
      font-weight: 800;
      margin: 0 0 0.5rem;
      font-family: var(--font-body);
    }

    .official-resources > p {
      color: var(--brand-mid-gray, #6b7280);
      margin: 0 0 1rem;
      font-size: 0.95rem;
    }

    .official-resources ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.65rem;
    }

    .official-resources li {
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .official-resources a {
      color: #1e40af;
      font-weight: 600;
      text-decoration: underline;
    }

    .official-resources a:hover {
      color: #1e3a8a;
    }
  </style>

  <!-- Prereq banner -->
  <section class="cowork-prereq" aria-label="Cowork prerequisites">
    <div class="container">
      <p>
        <strong>Claude Cowork required.</strong>
        These zips are for the Cowork desktop app on macOS or Windows
        with a paid Claude plan (Pro, Max, Team, Enterprise).
        <a href="https://claude.com/download" target="_blank" rel="noopener">
          Get Claude &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Hero -->
  <section class="cowork-hero">
    <h1>Download Plugin Packs</h1>
    <p>One-click downloads for Claude Cowork. No terminal needed. Just download, unzip, and drag into your project.</p>

    <div class="cowork-hero-stats">
      <div class="cowork-hero-stat">
        <span class="stat-number" data-count-provenance="cowork-package-local">{heroPluginCount.toLocaleString()}+</span>
        <span class="stat-label">Cowork-package-local plugins</span>
      </div>
      <div class="cowork-hero-stat">
        <span class="stat-number" data-count-provenance="cowork-package-local">{heroSkillCount.toLocaleString()}+</span>
        <span class="stat-label">Cowork-package-local skills</span>
      </div>
      <div class="cowork-hero-stat">
        <span class="stat-number" data-count-provenance="cowork-package-local">{categoryPackCount.toLocaleString()}</span>
        <span class="stat-label">Cowork-package-local category packs</span>
      </div>
    </div>
  </section>

  <!-- Mega download banner -->
  <div style="padding: 0 2rem;">
    <div class="mega-banner">
      <div class="mega-info">
        <h2>Download Everything</h2>
        <p>All <span data-count-provenance="cowork-package-local">{megaPluginCount.toLocaleString()} Cowork-package-local plugins</span> and <span data-count-provenance="cowork-package-local">{megaSkillCount.toLocaleString()} Cowork-package-local skills</span> in one zip</p>
        <div class="mega-stats">
          {megaZip && <span class="mega-stat">{megaZip.sizeFormatted}</span>}
        </div>
      </div>
      <a
        href={megaZip.path}
        download
        class="mega-download-btn"
      >
        Download All
      </a>
    </div>
  </div>

  <!-- Security info -->
  <div style="padding: 0 2rem;">
    <div class="security-banner">
      <h3>Safe & Verified Downloads</h3>
      <ul class="security-list">
        <li>All plugins are open source (MIT licensed)</li>
        <li>SHA-256 checksums in manifest.json</li>
        <li>No binary executables - markdown + config files only</li>
        <li>No API keys or secrets included</li>
        <li>Built from verified GitHub source</li>
        <li>Zero dependencies for AI instruction plugins</li>
      </ul>
    </div>
  </div>

  <!-- Category Bundles -->
  <section class="cowork-section">
    <h2 class="cowork-section-title">Category Packs</h2>
    <p class="cowork-section-subtitle">Download all plugins in a category at once. Each pack includes every plugin, skill, command, and agent for that topic.</p>

    <CoworkGrid />
  </section>

  <!-- Individual Plugin Downloads -->
  <section class="cowork-section">
    <h2 class="cowork-section-title">Individual Plugins</h2>
    <p class="cowork-section-subtitle">Search and download any single plugin.</p>

    <div class="plugin-search-container">
      <label for="plugin-search" class="sr-only">Search plugins by name</label>
      <input
        type="text"
        class="plugin-search-input"
        id="plugin-search"
        placeholder="Search plugins..."
        autocomplete="off"
        aria-label="Search plugins by name"
      />
      <p class="plugin-count-label" id="plugin-count" data-count-provenance="cowork-package-local">Showing all {allPlugins.length.toLocaleString()} Cowork-package-local plugins</p>

      <div class="plugin-list" id="plugin-list">
        {allPlugins.map(plugin => (
          <div class="plugin-item" data-name={plugin.name} data-category={plugin.category}>
            <span class="plugin-item-name">{plugin.name}</span>
            <span class="plugin-item-meta">{plugin.sizeFormatted}</span>
            <a
              href={plugin.path}
              download
              class="plugin-dl-btn"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              .zip
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Setup Guide -->
  <section class="cowork-section">
    <div class="setup-guide">
      <h2 class="cowork-section-title">How to Install</h2>
      <p class="cowork-section-subtitle">Four steps inside the Cowork desktop app. No terminal required.</p>

      <div class="setup-steps">
        <div class="setup-step">
          <div class="step-number">01</div>
          <h4>Download</h4>
          <p>Click any download button above. Your browser will save a .zip file to your Downloads folder.</p>
        </div>
        <div class="setup-step">
          <div class="step-number">02</div>
          <h4>Unzip</h4>
          <p>Double-click the .zip file to extract it. Keep the unzipped folder somewhere you can find it.</p>
        </div>
        <div class="setup-step">
          <div class="step-number">03</div>
          <h4>Open Cowork &rarr; Customize</h4>
          <p>In the Claude desktop app, switch to the <strong>Cowork</strong> tab, then click <strong>Customize</strong> in the left sidebar and choose <strong>Browse plugins</strong>. Use the upload-a-custom-plugin option to add your unzipped folder. See <a href="https://support.claude.com/en/articles/13837440-use-plugins-in-claude-cowork" target="_blank" rel="noopener">Use plugins in Claude Cowork</a> for the canonical walkthrough.</p>
        </div>
        <div class="setup-step">
          <div class="step-number">04</div>
          <h4>Restart if prompted</h4>
          <p>The plugin's skills, agents, and commands appear in your Cowork workspace once installed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Official Cowork resources -->
  <section class="cowork-section">
    <div class="official-resources">
      <h2>Official Claude Cowork resources</h2>
      <p>These zips are unofficial community packs. Anthropic's canonical Cowork docs and downloads live here:</p>
      <ul>
        <li>
          <a href="https://claude.com/product/cowork" target="_blank" rel="noopener">Claude Cowork product page</a>
          &mdash; what Cowork is, who it's for, pricing tiers
        </li>
        <li>
          <a href="https://claude.com/plugins" target="_blank" rel="noopener">Official plugin directory</a>
          &mdash; Anthropic-curated plugins, browseable in Cowork
        </li>
        <li>
          <a href="https://claude.com/download" target="_blank" rel="noopener">Download Claude desktop</a>
          &mdash; required to use any of these packs
        </li>
        <li>
          <a href="https://support.claude.com/en/articles/13345190-get-started-with-claude-cowork" target="_blank" rel="noopener">Get started with Claude Cowork</a>
          &mdash; Anthropic's official onboarding guide
        </li>
        <li>
          <a href="https://support.claude.com/en/articles/13837440-use-plugins-in-claude-cowork" target="_blank" rel="noopener">Use plugins in Claude Cowork</a>
          &mdash; Anthropic's canonical plugin-install walkthrough
        </li>
      </ul>
    </div>
  </section>

  <!-- Learning Path -->
  <section class="cowork-section">
    <div class="learning-path">
      <h3>New to Claude Code Plugins?</h3>
      <p>Start with our learning resources to get the most out of your plugins.</p>
      <div class="learning-links">
        <a href="/getting-started" class="learning-link">
          Getting Started Guide
        </a>
        <a href="/learning" class="learning-link">
          Learning Hub
        </a>
        <a href="/skills" class="learning-link">
          Browse Skills
        </a>
        <a href="/explore" class="learning-link">
          Explore Plugins
        </a>
      </div>
    </div>
  </section>

  <script>
    // Plugin search filter
    const searchInput = document.getElementById('plugin-search');
    const pluginList = document.getElementById('plugin-list');
    const pluginCount = document.getElementById('plugin-count');

    if (searchInput && pluginList) {
      const items = pluginList.querySelectorAll('.plugin-item');

      searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        let visible = 0;

        items.forEach(item => {
          const name = item.dataset.name || '';
          const category = item.dataset.category || '';
          const match = !query || name.includes(query) || category.includes(query);
          item.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        if (pluginCount) {
          pluginCount.textContent = query
            ? `Showing ${visible.toLocaleString()} of ${items.length.toLocaleString()} Cowork-package-local plugins`
            : `Showing all ${items.length.toLocaleString()} Cowork-package-local plugins`;
        }
      });
    }
  </script>
</BaseLayout>
