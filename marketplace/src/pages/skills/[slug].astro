---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DetailCta from '../../components/DetailCta.astro';
import skillsCatalog from '../../data/skills-catalog.json';

export async function getStaticPaths() {
  const skills = skillsCatalog.skills;

  return skills.map(skill => ({
    params: { slug: skill.slug },
    props: { skill }
  }));
}

const { skill } = Astro.props;

const pageTitle = `${skill.name} - Agent Skill`;
const pageDescription = skill.description || `Agent skill for Claude Code: ${skill.name}`;

// Format author (remove email if present)
const authorName = skill.author && typeof skill.author === 'string'
  ? skill.author.split('<')[0].trim()
  : 'Unknown';

const installCommand = `/plugin install ${skill.parentPlugin.name}@claude-code-plugins-plus`;

// Compatible platforms
const compatibleWith: string[] = (skill as any).compatibleWith || [];

// Stats bar items

// Related skills — 6 from same category, with tool pills
const relatedSkills = (skillsCatalog as any).skills
  .filter((s: any) => s.parentPlugin?.category === skill.parentPlugin?.category && s.slug !== skill.slug)
  .slice(0, 6);

const cleanTools = (tools: string[]) =>
  tools?.map((t: string) => t.replace(/^"|"$/g, '')).filter((t: string) => t.length > 0) || [];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <style>
    .skill-detail {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    .breadcrumb {
      font-size: 0.875rem;
      color: var(--text-2, var(--brand-mid-gray));
      margin-bottom: 2rem;
    }

    .breadcrumb a {
      color: var(--text-2, var(--brand-mid-gray));
      text-decoration: none;
      transition: color var(--duration-fast) var(--ease-out);
    }

    .breadcrumb a:hover {
      color: var(--primary);
    }

    .skill-header {
      margin-bottom: 2rem;
    }

    .skill-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--text, var(--brand-dark));
      margin-bottom: 1rem;
    }

    .skill-description {
      font-size: 1.1rem;
      color: var(--text-2, var(--brand-mid-gray));
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .skill-metadata {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-size: 0.875rem;
      color: var(--text-2, var(--brand-mid-gray));
      margin-bottom: 1rem;
    }

    .metadata-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Compatible platforms */
    .platform-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .platform-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 0.25rem 0.6rem;
      border-radius: var(--radius-sm);
      color: var(--text-2, var(--brand-mid-gray));
      border: 1px solid var(--rule, var(--border));
    }

    .section-box {
      padding: 1.5rem;
      background: var(--surface-2, var(--card));
      border: 1px solid var(--border, var(--brand-light-gray));
      border-radius: var(--radius-lg);
      margin-bottom: 1.5rem;

    }

    .section-box.dark {
      background: var(--brand-dark);
      border-color: var(--brand-dark);
    }

    .section-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text, var(--brand-dark));
      margin-bottom: 1rem;
      font-family: var(--font-body);
    }

    .section-box.dark .section-title {
      color: var(--brand-light);
    }

    .tools-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tool-badge {
      padding: 2px 8px;
      border: 1px solid var(--rule, var(--border));
      color: var(--ink-2, var(--text-2));
      border-radius: var(--radius-sm);
      font-size: 11px;
      font-weight: 500;
      font-family: var(--font-mono);
    }

    .plugin-info {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .plugin-details h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .plugin-details h3 a {
      color: inherit;
      text-decoration: none;
    }

    .plugin-details h3 a:hover {
      text-decoration: underline;
    }

    .plugin-details p {
      font-size: 0.9rem;
      color: var(--text-2, var(--brand-mid-gray));
      margin-bottom: 0.5rem;
    }

    .plugin-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
      color: var(--text-2, var(--brand-mid-gray));
    }

    .plugin-meta span {
      text-transform: capitalize;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.6rem 1.25rem;
      background: var(--primary);
      color: #0a0a0c;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.875rem;
      transition: all var(--duration-fast) var(--ease-out);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
    }

    .install-command {
      margin: 0;
      padding: 1rem 1.25rem;
      background: oklch(100.000% 0 0 / 0.08);
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      color: var(--primary-light);
      overflow-x: auto;
      cursor: pointer;
      font-family: 'SF Mono', 'Fira Code', monospace;
    }

    .install-note {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-2, var(--brand-mid-gray));
    }

    .skill-content-section {
      margin-top: 2rem;
    }

    .skill-content-section h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text, var(--brand-dark));
      margin-bottom: 1rem;
    }

    .skill-content {
      padding: 2rem;
      background: var(--surface-2, var(--card));
      border: 1px solid var(--border, var(--brand-light-gray));
      border-radius: var(--radius-lg);
      line-height: 1.8;

    }

    .skill-content h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text, var(--brand-dark));
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    .skill-content h2 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text, var(--brand-dark));
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .skill-content h3 {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text, var(--brand-dark));
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }

    .skill-content p {
      color: var(--text, var(--brand-dark));
      margin-bottom: 1rem;
    }

    .skill-content ul, .skill-content ol {
      margin-bottom: 1rem;
      padding-left: 1.5rem;
    }

    .skill-content li {
      color: var(--text, var(--brand-dark));
      margin-bottom: 0.5rem;
    }

    .skill-content code {
      background: var(--surface-3, var(--brand-light-gray));
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-family: 'SF Mono', 'Fira Code', monospace;
      color: var(--primary-dark);
    }

    .skill-content pre {
      background: var(--brand-dark);
      color: var(--brand-light);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-md);
      overflow-x: auto;
      margin-bottom: 1rem;
    }

    .skill-content pre code {
      background: transparent;
      color: var(--brand-light);
      padding: 0;
    }

    .skill-content blockquote {
      border-left: 4px solid var(--primary);
      padding-left: 1rem;
      font-style: italic;
      color: var(--text-2, var(--brand-mid-gray));
      margin-bottom: 1rem;
    }

    .skill-content a {
      color: var(--primary);
      text-decoration: underline;
    }

    .skill-content a:hover {
      text-decoration: none;
    }

    .skill-content table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      overflow-x: auto;
      display: block;
    }

    .skill-content thead {
      background: var(--surface-3, var(--brand-light-gray));
    }

    .skill-content th {
      padding: 0.6rem 0.85rem;
      text-align: left;
      font-weight: 600;
      color: var(--text, var(--brand-dark));
      border-bottom: 2px solid var(--border, var(--brand-light-gray));
      white-space: nowrap;
    }

    .skill-content td {
      padding: 0.5rem 0.85rem;
      border-bottom: 1px solid var(--border, var(--brand-light-gray));
      color: var(--text, var(--brand-dark));
      vertical-align: top;
    }

    .skill-content tbody tr:hover {
      background: var(--surface-2, oklch(0.000% 0 0 / 0.02));
    }

    .skill-content hr {
      border: none;
      border-top: 1px solid var(--border, var(--brand-light-gray));
      margin: 1.5rem 0;
    }

    .skill-content pre {
      position: relative;
    }

    .skill-content pre[data-lang]::before {
      content: attr(data-lang);
      position: absolute;
      top: 0;
      right: 0;
      padding: 0.2rem 0.6rem;
      font-size: 0.7rem;
      color: var(--text-3, var(--brand-mid-gray));
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-family: var(--font-mono);
      opacity: 0.6;
    }

    .related-skills-section {
      margin-top: 2rem;
    }

    .related-skills-heading {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text, var(--brand-dark));
      margin-bottom: 1rem;
    }

    .related-skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }

    .related-skill-card {
      display: block;
      padding: 1rem;
      background: var(--surface-2, var(--card));
      border: 1px solid var(--border, var(--brand-light-gray));
      border-radius: var(--radius-md);
      text-decoration: none;
      transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    }

    .related-skill-card:hover {
      border-color: var(--primary);
      transform: var(--card-hover-lift);
    }

    .related-skill-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text, var(--brand-dark));
      margin-bottom: 0.25rem;
    }

    .related-skill-description {
      font-size: 0.8rem;
      color: var(--text-2, var(--brand-mid-gray));
      line-height: 1.4;
      margin-bottom: 0.5rem;
    }

    .related-skill-tools {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .related-tool-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 0.1rem 0.35rem;
      border-radius: 0;
      color: var(--ink-2, var(--text-2));
      border: 1px solid var(--rule, var(--border));
    }

    @media (max-width: 768px) {
      .skill-detail {
        padding: 1rem;
      }

      .skill-header h1 {
        font-size: 1.75rem;
      }

      .plugin-info {
        flex-direction: column;
      }
    }
  </style>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "name": skill.name,
    "description": skill.description,
    "version": skill.version,
    "author": {
      "@type": "Person",
      "name": authorName
    },
    "license": skill.license,
    "programmingLanguage": "Claude Code Agent Skill",
    "isPartOf": {
      "@type": "SoftwareApplication",
      "name": skill.parentPlugin.name,
      "applicationCategory": skill.parentPlugin.category
    }
  })} />

  <div class="skill-detail">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs crumbs={[
      { label: 'Skills', href: '/skills/' },
      { label: skill.name },
    ]} />

    <!-- 2. Header (enhanced) -->
    <header class="skill-header">
      <h1>{skill.name}</h1>
      {skill.description && <p class="skill-description">{skill.description}</p>}

      <div class="skill-metadata">
        <div class="metadata-item">
          <span>v{skill.version}</span>
        </div>
        <div class="metadata-item">
          <span>{authorName}</span>
        </div>
        <div class="metadata-item">
          <span>{skill.license}</span>
        </div>
      </div>

      {compatibleWith.length > 0 && (
        <div class="platform-pills" style="margin-top: 1rem;">
          {compatibleWith.map((platform: string) => (
            <span class="platform-pill">{platform}</span>
          ))}
        </div>
      )}
    </header>

    <!-- 4. Allowed Tools -->
    <section class="section-box">
      <h2 class="section-title">Allowed Tools</h2>
      <div class="tools-grid">
        {skill.allowedTools.map(tool => (
          <span class="tool-badge">{tool}</span>
        ))}
      </div>
      {skill.allowedTools.length === 0 && (
        <p style="color: var(--brand-mid-gray); font-size: 0.875rem;">No tools specified</p>
      )}
    </section>

    <!-- 5. Provided by Plugin -->
    <section class="section-box">
      <h2 class="section-title">Provided by Plugin</h2>
      <div class="plugin-info">
        <div class="plugin-details">
          <h3>
            <a href={`/plugins/${skill.parentPlugin.name}/`}>{skill.parentPlugin.name}</a>
          </h3>
          <p>{skill.parentPlugin.description || 'Plugin for Claude Code'}</p>
          <div class="plugin-meta">
            <span>{skill.parentPlugin.category.replace(/-/g, ' ')}</span>
            {skill.parentPlugin.version && <span>v{skill.parentPlugin.version}</span>}
          </div>
        </div>
        <a href={`/plugins/${skill.parentPlugin.name}/`} class="btn-primary">View Plugin</a>
      </div>
    </section>

    <!-- 6. Installation -->
    <section class="section-box dark">
      <h2 class="section-title">Installation</h2>
      <p class="install-note" style="color: var(--brand-light-gray); margin-bottom: 0.75rem;">This skill is included in the {skill.parentPlugin.name} plugin:</p>
      <pre class="install-command" data-copy={installCommand}><code>{installCommand}</code></pre>
      <p class="install-note">Click to copy</p>
    </section>

    <!-- 7. Skill Content (Markdown) -->
    <section class="skill-content-section">
      <h2>Instructions</h2>
      <div class="skill-content">
        <div set:html={skill.content} />
      </div>
    </section>

    <!-- 8. Bottom CTA -->
    <DetailCta installCommand={installCommand} pluginName={skill.parentPlugin.name} />

    <!-- 9. Related Skills (6, with tool pills) -->
    {relatedSkills.length > 0 && (
      <section class="related-skills-section">
        <h2 class="related-skills-heading">Related Skills</h2>
        <div class="related-skills-grid">
          {relatedSkills.map((related: any) => (
            <a href={`/skills/${related.slug}/`} class="related-skill-card">
              <h3 class="related-skill-title">{related.name}</h3>
              <p class="related-skill-description">{typeof related.description === 'string' ? related.description.split('.')[0] + '.' : ''}</p>
              {cleanTools(related.allowedTools || []).length > 0 && (
                <div class="related-skill-tools">
                  {cleanTools(related.allowedTools).slice(0, 3).map((tool: string) => (
                    <span class="related-tool-pill">{tool}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

  </div>

  <!-- Copy functionality -->
  <script>
    document.querySelectorAll('.install-command').forEach(el => {
      el.addEventListener('click', function() {
        const text = this.dataset.copy || this.textContent;
        navigator.clipboard.writeText(text).then(() => {
          const originalText = this.textContent;
          this.textContent = 'Copied to clipboard!';
          this.style.color = 'var(--brand-green)';
          setTimeout(() => {
            this.textContent = originalText;
            this.style.color = '';
          }, 2000);
        });
      });
    });
  </script>
</BaseLayout>
