---
import BaseLayout from '../../layouts/BaseLayout.astro';
import vendorPacks from '../../data/vendor-packs.json';

const pageTitle = 'SaaS Skill Packs - Learn Hub';
const pageDescription = 'Deep integration packs for your favorite SaaS platforms, with focused coverage for complete workflows.';

const tierOrder = ['flagship+', 'flagship', 'pro', 'standard'];
const sortedVendors = [...vendorPacks.vendors].sort((a, b) => {
  return tierOrder.indexOf(a.tier) - tierOrder.indexOf(b.tier);
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <style>
    .learn-hero {
      background: var(--bg); border-bottom: 1px solid var(--rule);
      color: var(--ink);
      padding: 4rem 2rem 3rem;
      text-align: center;
    }

    .learn-title {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;
      line-height: 1.1;
    }

    .learn-subtitle {
      font-size: 1.2rem;
      opacity: 0.9;
      max-width: 700px;
      margin: 0 auto 2rem;
    }

    .hero-stats {
      display: flex;
      gap: 3rem;
      justify-content: center;
      margin-top: 2rem;
      font-size: 0.9rem;
      opacity: 0.9;
    }

    .hero-stat span {
      font-weight: 700;
      font-size: 1.4rem;
      display: block;
      color: var(--primary);
    }

    .vendors-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    .tier-section {
      margin-bottom: 3rem;
    }

    .tier-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .tier-badge {
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--rule);
      color: var(--ink-2);
      font-size: 11px;
      font-weight: 500;
      font-family: var(--font-mono);
    }

    .tier-description {
      color: var(--brand-mid-gray);
      font-size: 0.9rem;
    }

    .vendor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .vendor-card {
      background: var(--card);
      border: 1px solid var(--brand-light-gray);
      border-radius: 0;
      padding: 1.5rem;
      transition: all 0.2s ease;
      text-decoration: none;
      color: inherit;
    }

    .vendor-card:hover {
      transform: translateY(-2px);
      
      border-color: var(--primary);
    }

    .vendor-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .vendor-name {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0;
    }

    .vendor-description {
      color: var(--brand-mid-gray);
      font-size: 0.9rem;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .vendor-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--brand-light-gray);
    }

    .skill-count {
      font-weight: 600;
      color: var(--primary);
    }

    .install-hint {
      font-size: 0.8rem;
      color: var(--brand-mid-gray);
      font-family: monospace;
    }

    .coming-soon {
      text-align: center;
      padding: 2rem;
      background: var(--brand-light-gray);
      border-radius: 0;
      color: var(--brand-mid-gray);
    }

    @media (max-width: 768px) {
      .hero-stats {
        flex-direction: column;
        gap: 1rem;
      }

      .vendor-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <section class="learn-hero">
    <h1 class="learn-title">SaaS Skill Packs</h1>
    <p class="learn-subtitle">
      Deep integration packs for your favorite platforms. Each pack contains focused skills
      covering authentication, operations, debugging, and production best practices.
    </p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span data-count-provenance="learning-hub-aggregate">{vendorPacks.vendors.length}</span>
        learning-hub-aggregate vendor packs
      </div>
      <div class="hero-stat">
        <span data-count-provenance="learning-hub-aggregate">{vendorPacks.vendors.reduce((acc, v) => acc + v.skillCount, 0)}</span>
        learning-hub-aggregate skills across packs
      </div>
    </div>
  </section>

  <section class="vendors-section">
    {tierOrder.map(tier => {
      const tierVendors = sortedVendors.filter(v => v.tier === tier);
      const tierInfo = vendorPacks.tiers[tier];
      if (tierVendors.length === 0) return null;
      const counts = tierVendors.map(v => v.skillCount);
      const minimum = Math.min(...counts);
      const maximum = Math.max(...counts);
      const tierCounts = { label: minimum === maximum ? `${minimum}` : `${minimum}–${maximum}` };

      return (
        <div class="tier-section">
          <div class="tier-header">
            <span class={`tier-badge ${tier.replace('+', '-plus')}`}>
              {tierInfo.badge}
            </span>
            <span class="tier-description">
              <span data-count-provenance="vendor-pack-local">{tierCounts.label} vendor-pack-local skills per pack</span>
            </span>
          </div>

          <div class="vendor-grid">
            {tierVendors.map(vendor => (
              <a href={`/learn/${vendor.id}/`} class="vendor-card">
                <div class="vendor-header">
                  <h3 class="vendor-name">{vendor.name}</h3>
                </div>
                <p class="vendor-description">{vendor.description}</p>
                <div class="vendor-meta">
                  <span class="skill-count" data-count-provenance="vendor-pack-local">{vendor.skillCount} vendor-pack-local skills</span>
                  <span class="install-hint">View Pack</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="coming-soon">
      <h3>More Packs Coming Soon</h3>
      <p>We're building packs for 50 vendors.</p>
    </div>
  </section>
</BaseLayout>
