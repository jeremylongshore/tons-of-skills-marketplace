---
import VendorPackTemplate from '../../../components/VendorPackTemplate.astro';
import vendorPacks from '../../../data/vendor-packs.json';

const vendorId = 'supabase';
const vendor = vendorPacks.vendors.find((entry) => entry.id === vendorId);
if (!vendor) {
  return Astro.redirect('/learn/');
}
---

<VendorPackTemplate vendor={vendor} variant="default" badgeMode="count-only" />
