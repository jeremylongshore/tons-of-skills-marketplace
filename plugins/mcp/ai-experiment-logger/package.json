{
  "name": "@claude-plugins/ai-experiment-logger",
  "version": "1.0.0",
  "description": "Track and analyze AI experiments with MCP tools and web dashboard",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ai-experiment-logger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "web": "node dist/web/server.js",
    "test": "node --test tests/entrypoint.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:ci": "pnpm build && git diff --exit-code -- dist/index.js && node --test tests/entrypoint.test.mjs"
  },
  "keywords": [
    "mcp",
    "ai",
    "experiments",
    "logging",
    "analytics"
  ],
  "author": "Claude Code Plugins",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
