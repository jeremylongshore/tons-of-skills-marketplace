{
  "mcpServers": {
    "dolt-mcp-vcs": {
      "type": "stdio",
      "description": "Dolt version-control tools over stdio, with destructive operations refused by the mutation guard",
      "version": "0.3.6",
      "enabled": true,
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/dolt-mcp-guard.py",
        "--",
        "dolt-mcp-server",
        "--stdio",
        "--dolt",
        "--host", "${DOLT_HOST:-127.0.0.1}",
        "--port", "${DOLT_PORT:-3308}",
        "--user", "${DOLT_USER:-root}",
        "--database", "${DOLT_DATABASE:-beads}"
      ],
      "env": {
        "DOLT_PASSWORD": "${DOLT_PASSWORD:-}"
      }
    }
  }
}
