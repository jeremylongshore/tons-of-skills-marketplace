{
  "name": "@intentsolutionsio/ccpi",
  "version": "2.1.1",
  "description": "Command-line tool for Tons of Skills portable skills and marketplace plugins",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ccpi": "./dist/index.js",
    "tons": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && mkdir -p registry && cp ../../config/harness-registry.json registry/ && chmod +x dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "plugins",
    "cli",
    "agent-ops",
    "installation",
    "marketplace"
  ],
  "author": "Intent Solutions IO <jeremy@intentsolutions.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremylongshore/tons-of-skills-marketplace.git",
    "directory": "packages/cli"
  },
  "homepage": "https://tonsofskills.com",
  "bugs": {
    "url": "https://github.com/jeremylongshore/tons-of-skills-marketplace/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.3.5",
    "ora": "^8.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^12.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.41",
    "ajv": "^8.18.0",
    "eslint": "^9.39.4",
    "size-limit": "^12.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
